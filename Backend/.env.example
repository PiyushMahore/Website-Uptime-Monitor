# Server
PORT=5000
ORIGIN=http://localhost:5173

# MongoDB connection base URL. The app adds DB_NAME when the URL has no database path.
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=test

# Use separate, randomly generated secrets (at least 32 bytes each).
ACCESS_TOKEN=replace_with_a_random_access_token_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN=replace_with_a_different_random_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d

# Optional tuning
URL_CHECK_TIMEOUT_MS=10000
CHECK_INTERVAL_MS=180000
DB_CONNECT_TIMEOUT_MS=10000

# Gmail SMTP alerts. Use a Gmail app password, not your account password.
EMAIL=your-email@gmail.com
APP_PASSWORD=your-gmail-app-password

# Cloudinary uploads
CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret
